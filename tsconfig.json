{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react",
        "module": "CommonJS",
        "outDir": "dist",
        "strict": true,
        "target": "ES2016",
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
    },
    "include": ["src/**/*.tsx", "src/**/*.ts"],
    "exclude": [
        "node_modules",
        "build",
        "dist"
    ]
}
